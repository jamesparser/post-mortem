# LLM for the eulogy writer and the talking board. Nebius Token Factory.
# The server defaults to these values, so on a host only the keys are required.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-3-27b-it

# Vision for device recognition. MiniCPM-V on the same Nebius key.
VISION_BASE_URL=https://api.tokenfactory.nebius.com/v1
VISION_API_KEY=
VISION_MODEL=openbmb/MiniCPM-V-4_5

# Priest voice. Deepgram Aura. Nebius has no speech models.
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-zeus-en

PORT=3000
